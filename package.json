{
  "name": "kinoplan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brain:links": "node scripts/brain/check-links.mjs",
    "brain:status": "node scripts/brain/gen-status.mjs",
    "brain:regs": "node scripts/brain/check-registries.mjs",
    "brain:refs": "node scripts/brain/check-refs.mjs",
    "brain:boot": "node scripts/brain/check-boot.mjs",
    "brain:next": "node scripts/brain/next.mjs",
    "brain:handoff": "node scripts/brain/gen-handoff.mjs",
    "brain:check": "npm run brain:links && npm run brain:regs && npm run brain:refs && npm run brain:boot && npm run brain:handoff-check",
    "gate": "npm run build && npm run test && npm run test:e2e && npm run brain:check",
    "brain:handoff-check": "node scripts/brain/check-handoff.mjs",
    "brain:checkpoint": "node scripts/brain/gen-checkpoint.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-drag-handle": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "events": "^3.3.0",
    "immer": "^11.1.8",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-browser": "^9.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.12.3",
    "@types/pouchdb": "^6.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vercel": "^65.2.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
